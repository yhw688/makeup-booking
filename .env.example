NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
DB_PATH=./db/bookings.db
ADMIN_USERNAME=replace-with-admin-username
ADMIN_PASSWORD_HASH=replace-with-bcrypt-hash
SESSION_SECRET=replace-with-at-least-32-random-characters
WORKER_SECRET=replace-with-another-32-random-characters
SENDGRID_API_KEY=replace-with-sendgrid-mail-send-key
FROM_EMAIL=verified-sender@example.com
ARTIST_EMAIL=artist@example.com
# Set to 1 only behind Render's single trusted proxy. Keep 0 locally.
TRUST_PROXY=0
